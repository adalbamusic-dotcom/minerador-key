# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000
MCP_PUBLIC_BASE_URL=
MCP_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# Temporary private smoke test on a deployed HTTPS URL.
# Keep false until the OAuth flow is homologated; never use a bearer in a public integration.
MCP_ALLOW_REMOTE_BEARER=false

# OAuth 2.1 for remote MCP clients (ChatGPT, Claude). The issuer is derived from NEXT_PUBLIC_SUPABASE_URL.
# Requires the Supabase OAuth Server enabled and migration M7 applied. Keep false until then.
MCP_OAUTH_ENABLED=false

# Platform AI (OpenRouter since 2026-10-11). Server-only; never NEXT_PUBLIC_.
# The platform OpenRouter Connection must stay READY: it anchors authorization and the usage ledger.
# When set, this key takes precedence over the key saved in the Connection (Secret Store).
OPENROUTER_API_KEY=
# Optional. Any OpenRouter model slug except :batch variants, which fail on chat/completions.
# Empty = code default (openai/gpt-6-luna-pro).
OPENROUTER_MODEL=
