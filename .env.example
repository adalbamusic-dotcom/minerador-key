# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret

# Google OAuth / Google Sheets
GOOGLE_CLIENT_ID=fake-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=fake-google-client-secret

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=fake-public-anon-key

# Supabase server-only credential
SUPABASE_SERVICE_ROLE_KEY=fake-service-role-key
ADMIN_EMAIL=admin@example.com

# AI providers
DEEPSEEK_API_KEY=fake-deepseek-api-key
OPENROUTER_API_KEY=fake-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-chat

# Keyword volume providers
KEYWORDS_EVERYWHERE_API_KEY=fake-keywords-everywhere-api-key
RAPIDAPI_KEY=fake-rapidapi-key
RAPIDAPI_HOST=example-rapidapi-host.p.rapidapi.com
RAPIDAPI_URL=https://example-rapidapi-host.p.rapidapi.com/v1/keywords

# Test configuration. Real database tests remain disabled unless explicitly enabled.
TEST_API_BASE=http://localhost:3000
TEST_AUTH_EMAIL=test-admin@example.com
TEST_AUTH_PASSWORD=fake-test-password
ALLOW_REAL_DB_TESTS=false
