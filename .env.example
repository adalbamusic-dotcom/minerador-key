# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret

# Public application base URL used by transactional isolated-auth links
APP_BASE_URL=http://localhost:3000

# Server-side AgencyInvitation lifecycle policy: production, staging, development or test.
# If absent/unknown, the safe production TTL is used.
AGENCY_INVITATION_ENV=development

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=fake-public-anon-key
# Supabase server-only credential
SUPABASE_SERVICE_ROLE_KEY=fake-service-role-key

# AI providers
# IA é resolvida exclusivamente pela Connection DeepSeek da Plataforma.
# Não configurar provider ou segredo de IA no ambiente do app.

# Google Ads server-only foundation. Never prefix these variables with NEXT_PUBLIC_.
GOOGLE_ADS_DEVELOPER_TOKEN=fake-google-ads-developer-token
GOOGLE_ADS_CLIENT_ID=fake-google-ads-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=fake-google-ads-client-secret
GOOGLE_ADS_REFRESH_TOKEN=fake-google-ads-refresh-token
# MCC/login customer is optional and is not the advertiser customer.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_RESEARCH_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=

# DataForSEO server-only allintitle. Paid smoke is manual; never expose these in the browser.
DATAFORSEO_LOGIN=fake-dataforseo-login
DATAFORSEO_PASSWORD=fake-dataforseo-password
DATAFORSEO_BASE_URL=https://api.dataforseo.com
DATAFORSEO_LOCATION_CODE=2076
DATAFORSEO_LANGUAGE_CODE=pt
DATAFORSEO_TIMEOUT_MS=30000

# Optional future delivery webhook verification. Configure only with the provider gate.
COMMUNICATION_WEBHOOK_SECRET=replace-with-a-webhook-secret
