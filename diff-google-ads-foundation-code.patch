+} from "./google-ads.fixture.ts";
+
+const config = getGoogleAdsServerConfig({
+  GOOGLE_ADS_DEVELOPER_TOKEN: "test-developer-token",
+  GOOGLE_ADS_CLIENT_ID: "test-client-id",
+  GOOGLE_ADS_CLIENT_SECRET: "test-client-secret",
+  GOOGLE_ADS_REFRESH_TOKEN: "test-refresh-token",
+  GOOGLE_ADS_LOGIN_CUSTOMER_ID: "111-222-3333",
+  GOOGLE_ADS_API_VERSION: "v25",
+});
+const targeting = { language: "languageConstants/1014", geoTargetConstants: ["geoTargetConstants/2076"], keywordPlanNetwork: "GOOGLE_SEARCH" as const, includeAdultKeywords: false };
+const account = { customerId: "1234567890", loginCustomerId: "1112223333", currencyCode: "BRL", timeZone: "America/Sao_Paulo" };
+
+function response(payload: unknown, status = 200, headers: Record<string, string> = {}) {
+  return new Response(JSON.stringify(payload), { status, headers: { "content-type": "application/json", ...headers } });
+}
+
+test("configura├º├úo exige vers├úo expl├¡cita e n├úo permite customerId inv├ílido", () => {
+  assert.equal(config.apiVersion, "v25");
+  assert.equal(normalizeGoogleAdsCustomerId("123-456-7890"), "1234567890");
+  assert.throws(() => normalizeGoogleAdsCustomerId("adalba"), (error: unknown) => error instanceof GoogleAdsError && error.code === "google_ads_invalid_customer_id");
+  assert.throws(() => getGoogleAdsServerConfig({
+    GOOGLE_ADS_DEVELOPER_TOKEN: "test-developer-token",
+    GOOGLE_ADS_CLIENT_ID: "test-client-id",
+    GOOGLE_ADS_CLIENT_SECRET: "test-client-secret",
+    GOOGLE_ADS_REFRESH_TOKEN: "test-refresh-token",
+    GOOGLE_ADS_API_VERSION: "latest",
+  }), (error: unknown) => error instanceof GoogleAdsError && error.code === "google_ads_configuration");
+});
+
+test("OAuth usa refresh token somente no servidor, reutiliza cache curto e sanitiza falha", async () => {
+  resetGoogleAdsAccessTokenCacheForTests();
+  let calls = 0;
+  const fetchFn = (async (url: string, init?: RequestInit) => {
+    calls += 1;
+    assert.equal(url, "https://oauth2.googleapis.com/token");
+    assert.equal(init?.method, "POST");
+    assert.match(String(init?.body), /grant_type=refresh_token/);
+    return response({ access_token: "short-lived-access-token", expires_in: 3600 });
+  }) as typeof fetch;
+  assert.equal(await getGoogleAdsAccessToken({ config, fetchFn }), "short-lived-access-token");
+  assert.equal(await getGoogleAdsAccessToken({ config, fetchFn }), "short-lived-access-token");
+  assert.equal(calls, 1);
+
+  resetGoogleAdsAccessTokenCacheForTests();
+  await assert.rejects(
+    () => getGoogleAdsAccessToken({ config, fetchFn: (async () => response(googleAdsOauthErrorFixture, 400)) as typeof fetch }),
+    (error: unknown) => googleAdsSafeError(error).code === "google_ads_oauth" && !googleAdsSafeError(error).message.includes("refresh"),
+  );
+});
+
+test("cliente versiona URL, separa MCC/customer e n├úo inclui segredos em erro", async () => {
+  let requestedUrl = "";
+  let requestHeaders: Record<string, string | null> = {};
+  const client = createGoogleAdsRestClient({
+    config,
+    getAccessToken: async () => "access-token",
+    fetchFn: (async (url: string, init?: RequestInit) => {
+      requestedUrl = url;
+      const headers = new Headers(init?.headers);
+      requestHeaders = {
+        loginCustomerId: headers.get("login-customer-id"),
+        developerToken: headers.get("developer-token"),
+      };
+      return response({ ok: true }, 200, { "request-id": "google-request-1" });
+    }) as typeof fetch,
+  });
+  const result = await client.post("123-456-7890", "generateKeywordIdeas", { any: true });
+  assert.equal(requestedUrl, "https://googleads.googleapis.com/v25/customers/1234567890/generateKeywordIdeas");
+  assert.equal(requestHeaders.loginCustomerId, "1112223333");
+  assert.equal(requestHeaders.developerToken, "test-developer-token");
+  assert.equal(result.requestId, "google-request-1");
+  assert.equal(googleAdsSafeError(new GoogleAdsError("google_ads_provider_error")).message.includes("token"), false);
+});
