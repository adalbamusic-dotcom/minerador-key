+  const client = createGoogleAdsRestClient({ config, getAccessToken: async () => "access-token", fetchFn: (async (url: string, init?: RequestInit) => {
+    calls.push({ url, body: JSON.parse(String(init?.body)) });
+    return response(googleAdsAccountFixture);
+  }) as typeof fetch });
+  const resolved = await resolveGoogleAdsAdvertiserAccount(client, { customerId: "123-456-7890", loginCustomerId: "111-222-3333" });
+  assert.deepEqual(resolved, account);
+  const requestBody = calls[0].body as { query: string };
+  assert.match(requestBody.query, /customer\.currency_code/);
+  assert.match(requestBody.query, /customer\.time_zone/);
+});
+
+test("ideias suportam keyword e URL seed com targeting expl├¡cito e pagina├º├úo", async () => {
+  const bodies: unknown[] = [];
+  const client = createGoogleAdsRestClient({ config, getAccessToken: async () => "access-token", fetchFn: (async (_url: string, init?: RequestInit) => {
+    const body = JSON.parse(String(init?.body));
+    bodies.push(body);
+    return response(bodies.length === 1 ? googleAdsKeywordIdeasKeywordSeedFixture : googleAdsKeywordIdeasUrlSeedFixture);
+  }) as typeof fetch });
+  const keywordResult = await generateGoogleAdsKeywordIdeas(client, { account: { customerId: account.customerId }, targeting, pageToken: "start", seed: { kind: "keyword", keywords: ["marketing para cl├¡nicas"] } }, account, "v25");
+  const urlResult = await generateGoogleAdsKeywordIdeas(client, { account: { customerId: account.customerId }, targeting, seed: { kind: "url", url: "https://adalbapro.com.br" } }, account, "v25");
+  assert.deepEqual((bodies[0] as { keywordSeed: unknown }).keywordSeed, { keywords: ["marketing para cl├¡nicas"] });
+  assert.equal((bodies[0] as { pageToken: string }).pageToken, "start");
+  assert.deepEqual((bodies[1] as { urlSeed: unknown }).urlSeed, { url: "https://adalbapro.com.br" });
+  assert.equal(keywordResult.ideas[0].averageMonthlySearches, 720);
+  assert.equal(keywordResult.nextPageToken, "next-page");
+  assert.equal(urlResult.ideas[0].currencyCode, "BRL");
+});
+
+test("m├®tricas hist├│ricas preservam 12 meses, micros, null e include_average_cpc", async () => {
+  const bodies: unknown[] = [];
+  const client = createGoogleAdsRestClient({ config, getAccessToken: async () => "access-token", fetchFn: (async (_url: string, init?: RequestInit) => {
+    bodies.push(JSON.parse(String(init?.body)));
+    return response(bodies.length === 1 ? googleAdsHistoricalMetricsFixture : googleAdsHistoricalMetricsWithoutCpcFixture);
+  }) as typeof fetch });
+  const present = await generateGoogleAdsHistoricalMetrics(client, { account: { customerId: account.customerId }, targeting, keywords: ["marketing para cl├¡nicas"], includeAverageCpc: true }, account, "v25");
+  const absent = await generateGoogleAdsHistoricalMetrics(client, { account: { customerId: account.customerId }, targeting, keywords: ["keyword sem volume"], includeAverageCpc: false }, account, "v25");
+  assert.deepEqual((bodies[0] as { historicalMetricsOptions: unknown }).historicalMetricsOptions, { includeAverageCpc: true });
+  assert.equal("historicalMetricsOptions" in (bodies[1] as object), false);
+  assert.equal(present.metrics[0].monthlySearchVolumes.length, 12);
+  assert.equal(present.metrics[0].averageCpcMicros, "2200000");
+  assert.equal(present.metrics[0].providerVersion, "v25");
+  assert.equal(absent.metrics[0].averageMonthlySearches, null);
+  assert.equal(absent.metrics[0].averageCpcMicros, null);
+});
+
+test("erros de conta, quota, resposta malformada e timeout s├úo distintos", async () => {
+  const accountClient = createGoogleAdsRestClient({ config, getAccessToken: async () => "access-token", fetchFn: (async () => response(googleAdsAccountErrorFixture, 403)) as typeof fetch });
+  await assert.rejects(() => accountClient.post("1234567890", "generateKeywordIdeas", {}), (error: unknown) => error instanceof GoogleAdsError && error.code === "google_ads_account_not_authorized");
+  const quotaClient = createGoogleAdsRestClient({ config, getAccessToken: async () => "access-token", fetchFn: (async () => response(googleAdsQuotaErrorFixture, 429)) as typeof fetch });
+  await assert.rejects(() => quotaClient.post("1234567890", "generateKeywordIdeas", {}), (error: unknown) => error instanceof GoogleAdsError && error.code === "google_ads_quota");
+  const rateLimitedClient = createGoogleAdsRestClient({ config, getAccessToken: async () => "access-token", fetchFn: (async () => response({ error: { status: "TOO_MANY_REQUESTS" } }, 429)) as typeof fetch });
+  await assert.rejects(() => rateLimitedClient.post("1234567890", "generateKeywordIdeas", {}), (error: unknown) => error instanceof GoogleAdsError && error.code === "google_ads_rate_limited");
+  assert.throws(() => normalizeGoogleAdsKeywordResult({ keyword: "teste", metrics: { monthlySearchVolumes: [{}] }, account, targeting, providerVersion: "v25" }), (error: unknown) => error instanceof GoogleAdsError && error.code === "google_ads_invalid_response");
+  const timeoutClient = createGoogleAdsRestClient({ config, getAccessToken: async () => "access-token", fetchFn: (async () => { throw new DOMException("timeout", "TimeoutError"); }) as typeof fetch });
+  await assert.rejects(() => timeoutClient.post("1234567890", "generateKeywordIdeas", {}), (error: unknown) => error instanceof GoogleAdsError && error.code === "google_ads_timeout");
+});
