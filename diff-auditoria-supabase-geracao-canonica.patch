@@ -0,0 +1,353 @@
+-- Auditoria profunda de Supabase ÔÇö gera├º├úo can├┤nica
+-- MODO SOMENTE LEITURA: este arquivo cont├®m somente SELECT e WITH.
+-- N├úo execute scripts de bootstrap, demote, migration, rollback ou provider junto dele.
+-- N├úo exporte e-mails, JWTs, tokens, chaves, prompts ou secrets.
+
+-- 1. Identifica├º├úo t├®cnica da sess├úo e do ledger de migrations.
+SELECT current_database() AS database_name,
+       current_user AS database_role,
+       current_setting('server_version') AS postgres_version,
+       now() AT TIME ZONE 'UTC' AS audited_at_utc;
+
+SELECT schemaname, tablename
+FROM pg_catalog.pg_tables
+WHERE schemaname IN ('supabase_migrations', 'public')
+  AND tablename = 'schema_migrations'
+ORDER BY schemaname, tablename;
+
+SELECT version, name, statements, inserted_at
+FROM supabase_migrations.schema_migrations
+ORDER BY version;
+
+-- 2. Rela├º├Áes p├║blicas: invent├írio, owner, RLS e tamanho aproximado.
+SELECT n.nspname AS schema_name,
+       c.relname AS relation_name,
+       CASE c.relkind
+         WHEN 'r' THEN 'table'
+         WHEN 'p' THEN 'partitioned_table'
+         WHEN 'v' THEN 'view'
+         WHEN 'm' THEN 'materialized_view'
+         WHEN 'S' THEN 'sequence'
+         WHEN 'f' THEN 'foreign_table'
+         ELSE c.relkind::text
+       END AS relation_kind,
+       pg_get_userbyid(c.relowner) AS owner_role,
+       c.relrowsecurity AS rls_enabled,
+       c.relforcerowsecurity AS force_rls,
+       CASE
+         WHEN c.relkind IN ('r', 'p') AND NOT c.relrowsecurity THEN 'UNRESTRICTED'
+         WHEN c.relkind IN ('r', 'p') AND c.relrowsecurity THEN 'RLS_ENABLED'
+         ELSE 'NOT_APPLICABLE'
+       END AS rls_state,
+       c.reltuples::bigint AS estimated_rows
+FROM pg_catalog.pg_class c
+JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
+WHERE n.nspname = 'public'
+  AND c.relkind IN ('r', 'p', 'v', 'm', 'S', 'f')
+ORDER BY relation_kind, relation_name;
+
+-- 3. Todas as colunas das tabelas p├║blicas, sem ler valores de dados.
+SELECT table_name,
+       ordinal_position,
+       column_name,
+       data_type,
+       udt_schema,
+       udt_name,
+       is_nullable,
+       column_default,
+       is_identity,
+       identity_generation,
+       is_generated,
+       generation_expression
+FROM information_schema.columns
+WHERE table_schema = 'public'
+ORDER BY table_name, ordinal_position;
+
+-- 4. Constraints, incluindo FKs e a├º├Áes de UPDATE/DELETE.
+SELECT con.conrelid::regclass::text AS table_name,
+       con.conname AS constraint_name,
+       CASE con.contype
+         WHEN 'p' THEN 'PRIMARY_KEY'
+         WHEN 'u' THEN 'UNIQUE'
+         WHEN 'f' THEN 'FOREIGN_KEY'
+         WHEN 'c' THEN 'CHECK'
+         WHEN 'x' THEN 'EXCLUSION'
+         ELSE con.contype::text
+       END AS constraint_type,
+       CASE con.confdeltype
+         WHEN 'a' THEN 'NO_ACTION'
+         WHEN 'r' THEN 'RESTRICT'
+         WHEN 'c' THEN 'CASCADE'
+         WHEN 'n' THEN 'SET_NULL'
+         WHEN 'd' THEN 'SET_DEFAULT'
+         ELSE NULL
+       END AS on_delete,
+       CASE con.confupdtype
+         WHEN 'a' THEN 'NO_ACTION'
+         WHEN 'r' THEN 'RESTRICT'
+         WHEN 'c' THEN 'CASCADE'
+         WHEN 'n' THEN 'SET_NULL'
+         WHEN 'd' THEN 'SET_DEFAULT'
+         ELSE NULL
+       END AS on_update,
+       con.condeferrable AS deferrable,
+       con.condeferred AS initially_deferred,
+       con.convalidated AS validated,
+       pg_get_constraintdef(con.oid, true) AS definition
+FROM pg_catalog.pg_constraint con
+JOIN pg_catalog.pg_class rel ON rel.oid = con.conrelid
+JOIN pg_catalog.pg_namespace ns ON ns.oid = rel.relnamespace
+WHERE ns.nspname = 'public'
+ORDER BY table_name, constraint_type, constraint_name;
+
+-- 5. ├ìndices, inclusive o ├¡ndice parcial que protege um ├║nico v├¡nculo ativo ag├¬nciaÔÇômarca.
+SELECT schemaname,
+       tablename,
+       indexname,
+       indexdef
+FROM pg_catalog.pg_indexes
+WHERE schemaname = 'public'
+ORDER BY tablename, indexname;
+
+WITH expected_indexes(index_name, purpose) AS (
+  VALUES
+    ('uq_brand_memberships_member_user_0005', 'unicidade marca + ator UUID'),
+    ('uq_brand_memberships_legacy_key_0005', 'compatibilidade marca + user_key'),
+    ('uq_agency_brands_active_brand_0014', 'no m├íximo uma ag├¬ncia ativa por marca')
+)
+SELECT e.index_name,
+       e.purpose,
+       i.indexname IS NOT NULL AS exists_in_catalog,
+       i.indexdef
+FROM expected_indexes e
+LEFT JOIN pg_catalog.pg_indexes i
+  ON i.schemaname = 'public'
+ AND i.indexname = e.index_name
+ORDER BY e.index_name;
+
+-- 6. RLS e pol├¡ticas efetivamente instaladas.
+SELECT schemaname,
+       tablename,
+       policyname,
+       permissive,
+       roles,
+       cmd,
+       qual,
+       with_check
+FROM pg_catalog.pg_policies
+WHERE schemaname = 'public'
+ORDER BY tablename, policyname;
+
+WITH sensitive_relations(table_name) AS (
+  VALUES
+    ('tenant_0005_migration_guard'), ('marcas'), ('perfis'), ('listas_kgr'), ('keywords_kgr'),
+    ('brand_memberships'), ('brand_member_permissions'), ('agencies'), ('agency_memberships'), ('agency_brands'),
+    ('minerador_google_ads_connections'), ('minerador_keyword_metric_measurements')
+)
+SELECT s.table_name,
+       c.relkind IS NOT NULL AS relation_exists,
+       COALESCE(c.relrowsecurity, false) AS rls_enabled,
+       COALESCE(c.relforcerowsecurity, false) AS force_rls,
+       COUNT(p.policyname) AS policy_count,
+       CASE
+         WHEN c.relkind IS NULL THEN 'MISSING'
+         WHEN NOT c.relrowsecurity THEN 'UNRESTRICTED'
+         WHEN COUNT(p.policyname) = 0 THEN 'RLS_WITHOUT_POLICY'
+         ELSE 'POLICIES_PRESENT'
+       END AS audit_state
+FROM sensitive_relations s
+LEFT JOIN pg_catalog.pg_class c
+  ON c.relname = s.table_name
+ AND c.relnamespace = 'public'::regnamespace
+LEFT JOIN pg_catalog.pg_policies p
+  ON p.schemaname = 'public'
+ AND p.tablename = s.table_name
+GROUP BY s.table_name, c.relkind, c.relrowsecurity, c.relforcerowsecurity
+ORDER BY s.table_name;
+
+-- 7. Grants de tabelas, schemas e fun├º├Áes; nenhuma defini├º├úo de fun├º├úo ├® exposta.
+SELECT table_schema,
+       table_name,
+       grantee,
+       privilege_type,
+       is_grantable
+FROM information_schema.role_table_grants
+WHERE table_schema = 'public'
+ORDER BY table_name, grantee, privilege_type;
+
+SELECT n.nspname AS schema_name,
+       r.rolname AS grantee,
+       has_schema_privilege(r.rolname, n.oid, 'USAGE') AS has_usage,
+       has_schema_privilege(r.rolname, n.oid, 'CREATE') AS has_create
+FROM pg_catalog.pg_namespace n
+CROSS JOIN pg_catalog.pg_roles r
+WHERE n.nspname = 'public'
+  AND r.rolname IN ('anon', 'authenticated', 'service_role', 'postgres')
+ORDER BY r.rolname;
+
+SELECT n.nspname AS schema_name,
+       p.proname AS function_name,
+       pg_get_function_identity_arguments(p.oid) AS arguments,
+       pg_get_userbyid(p.proowner) AS owner_role,
+       p.prosecdef AS security_definer,
+       p.proconfig AS function_settings,
+       has_function_privilege('anon', p.oid, 'EXECUTE') AS anon_can_execute,
+       has_function_privilege('authenticated', p.oid, 'EXECUTE') AS authenticated_can_execute,
+       has_function_privilege('PUBLIC', p.oid, 'EXECUTE') AS public_can_execute
+FROM pg_catalog.pg_proc p
+JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
+WHERE n.nspname = 'public'
+ORDER BY function_name, arguments;
+
+-- 8. Triggers e depend├¬ncias declaradas no cat├ílogo.
+SELECT event_object_table AS table_name,
+       trigger_name,
+       event_manipulation,
+       action_timing,
+       action_orientation,
+       action_condition,
+       action_statement
+FROM information_schema.triggers
+WHERE trigger_schema = 'public'
+ORDER BY table_name, trigger_name, event_manipulation;
+
+SELECT objid::regclass::text AS dependent_object,
+       refobjid::regclass::text AS referenced_object,
+       deptype
+FROM pg_catalog.pg_depend d
+JOIN pg_catalog.pg_class obj ON obj.oid = d.objid
+JOIN pg_catalog.pg_namespace ns ON ns.oid = obj.relnamespace
+WHERE ns.nspname = 'public'
+  AND d.classid = 'pg_class'::regclass
+  AND d.refclassid = 'pg_class'::regclass
+ORDER BY dependent_object, referenced_object;
+
+-- 9. Cobertura esperada por migration, separando ledger de objeto instalado.
+WITH expected_objects(migration_version, object_name, object_kind) AS (
+  VALUES
+    ('0005', 'tenant_0005_migration_guard', 'table'), ('0005', 'can_access_brand', 'function'),
+    ('0005', 'can_manage_brand', 'function'), ('0005', 'tenant_actor_has_permission', 'function'),
+    ('0007', 'minerador_google_ads_connections', 'table'), ('0009', 'minerador_discovery_runs', 'table'),
+    ('0010', 'minerador_discovery_import_batches', 'table'), ('0013', 'minerador_discovery_candidate_current_metrics', 'table'),
+    ('0014', 'agencies', 'table'), ('0014', 'agency_memberships', 'table'), ('0014', 'agency_brands', 'table'),
+    ('0014', 'can_access_agency', 'function'), ('0014', 'can_manage_agency', 'function')
+), ledger AS (
+  SELECT version::text AS version FROM supabase_migrations.schema_migrations
+), objects AS (
+  SELECT c.relname AS object_name, 'table' AS object_kind
+  FROM pg_catalog.pg_class c
+  WHERE c.relnamespace = 'public'::regnamespace AND c.relkind IN ('r', 'p')
+  UNION ALL
+  SELECT p.proname, 'function'
+  FROM pg_catalog.pg_proc p
+  WHERE p.pronamespace = 'public'::regnamespace
+)
+SELECT e.migration_version,
+       e.object_name,
+       e.object_kind,
+       EXISTS (SELECT 1 FROM ledger l WHERE l.version LIKE e.migration_version || '%') AS migration_in_ledger,
+       EXISTS (SELECT 1 FROM objects o WHERE o.object_name = e.object_name AND o.object_kind = e.object_kind) AS object_in_catalog,
+       CASE
+         WHEN EXISTS (SELECT 1 FROM ledger l WHERE l.version LIKE e.migration_version || '%')
+          AND EXISTS (SELECT 1 FROM objects o WHERE o.object_name = e.object_name AND o.object_kind = e.object_kind) THEN 'LEDGER_AND_OBJECT'
+         WHEN EXISTS (SELECT 1 FROM ledger l WHERE l.version LIKE e.migration_version || '%') THEN 'LEDGER_WITHOUT_EXPECTED_OBJECT'
+         WHEN EXISTS (SELECT 1 FROM objects o WHERE o.object_name = e.object_name AND o.object_kind = e.object_kind) THEN 'OBJECT_OUTSIDE_LEDGER_OR_DIFFERENT_VERSION'
+         ELSE 'NOT_FOUND'
+       END AS audit_state
+FROM expected_objects e
+ORDER BY e.migration_version, e.object_kind, e.object_name;
+
+-- 10. Integridade de identidade e membership. Retorna somente contagens e UUIDs t├®cnicos.
+SELECT
+  (SELECT count(*) FROM public.marcas) AS brands_total,
+  (SELECT count(*) FROM public.marcas WHERE owner_user_id IS NULL) AS brands_without_owner,
+  (SELECT count(*) FROM public.marcas b WHERE owner_user_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM auth.users u WHERE u.id = b.owner_user_id)) AS brands_with_missing_auth_owner,
+  (SELECT count(*) FROM public.brand_memberships WHERE member_user_id IS NULL) AS memberships_without_actor_uuid,
+  (SELECT count(*) FROM public.brand_memberships WHERE nullif(btrim(user_key), '') IS NOT NULL) AS memberships_with_legacy_user_key,
+  (SELECT count(*) FROM public.brand_memberships bm WHERE member_user_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM auth.users u WHERE u.id = bm.member_user_id)) AS memberships_with_missing_auth_actor;
+
+SELECT marca_id,
+       member_user_id,
+       count(*) AS duplicated_memberships
+FROM public.brand_memberships
+WHERE member_user_id IS NOT NULL
+GROUP BY marca_id, member_user_id
+HAVING count(*) > 1
+ORDER BY duplicated_memberships DESC, marca_id, member_user_id;
+
+SELECT marca_id,
+       count(*) AS active_owner_memberships
+FROM public.brand_memberships
+WHERE status = 'active' AND role = 'owner'
+GROUP BY marca_id
+HAVING count(*) <> 1
+ORDER BY marca_id;
+
+-- 11. Integridade de lista/keyword e prote├º├úo RESTRICT.
+SELECT
+  (SELECT count(*) FROM public.listas_kgr WHERE marca_id IS NULL) AS lists_without_brand,
+  (SELECT count(*) FROM public.keywords_kgr WHERE brand_id IS NULL) AS keywords_without_brand,
+  (SELECT count(*) FROM public.keywords_kgr k WHERE k.lista_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM public.listas_kgr l WHERE l.id = k.lista_id)) AS keywords_with_missing_list,
+  (SELECT count(*) FROM public.keywords_kgr k JOIN public.listas_kgr l ON l.id = k.lista_id WHERE k.lista_id IS NOT NULL AND k.brand_id IS DISTINCT FROM l.marca_id) AS keywords_cross_brand_list;
+
+SELECT con.conname AS foreign_key,
+       pg_get_constraintdef(con.oid, true) AS definition,
+       CASE con.confdeltype WHEN 'r' THEN 'RESTRICT' WHEN 'a' THEN 'NO_ACTION' WHEN 'c' THEN 'CASCADE' WHEN 'n' THEN 'SET_NULL' WHEN 'd' THEN 'SET_DEFAULT' END AS on_delete
+FROM pg_catalog.pg_constraint con
+WHERE con.conrelid = 'public.keywords_kgr'::regclass
+  AND con.contype = 'f'
+ORDER BY con.conname;
+
+-- 12. Integridade de ag├¬ncia. Execute somente depois de a se├º├úo 9 indicar as tr├¬s tabelas no cat├ílogo.
+SELECT
+  (SELECT count(*) FROM public.agencies) AS agencies_total,
+  (SELECT count(*) FROM public.agency_memberships am WHERE NOT EXISTS (SELECT 1 FROM auth.users u WHERE u.id = am.user_id)) AS agency_memberships_missing_auth_actor,
+  (SELECT count(*) FROM public.agency_brands ab WHERE NOT EXISTS (SELECT 1 FROM public.marcas b WHERE b.id = ab.brand_id)) AS agency_links_missing_brand,
+  (SELECT count(*) FROM public.agency_brands ab WHERE NOT EXISTS (SELECT 1 FROM public.agencies a WHERE a.id = ab.agency_id)) AS agency_links_missing_agency;
+
+SELECT brand_id,
+       count(*) AS active_agency_links
+FROM public.agency_brands
+WHERE status = 'active'
+GROUP BY brand_id
+HAVING count(*) > 1
+ORDER BY active_agency_links DESC, brand_id;
+
+-- 13. Integridade de dados operacionais e editoriais, em contagens seguras.
+SELECT
+  (SELECT count(*) FROM public.minerador_google_ads_connections c WHERE NOT EXISTS (SELECT 1 FROM public.marcas b WHERE b.id = c.brand_id)) AS google_ads_connections_without_brand,
+  (SELECT count(*) FROM public.minerador_keyword_metric_measurements m WHERE NOT EXISTS (SELECT 1 FROM public.marcas b WHERE b.id = m.brand_id)) AS keyword_measurements_without_brand,
+  (SELECT count(*) FROM public.minerador_discovery_runs r WHERE NOT EXISTS (SELECT 1 FROM public.marcas b WHERE b.id = r.brand_id)) AS discovery_runs_without_brand,
+  (SELECT count(*) FROM public.minerador_discovery_import_batches b WHERE NOT EXISTS (SELECT 1 FROM public.marcas m WHERE m.id = b.brand_id)) AS discovery_import_batches_without_brand,
+  (SELECT count(*) FROM public.editorial_artifact_versions a WHERE NOT EXISTS (SELECT 1 FROM public.marcas b WHERE b.id = a.marca_id)) AS artifact_versions_without_brand,
+  (SELECT count(*) FROM public.publication_records p WHERE NOT EXISTS (SELECT 1 FROM public.marcas b WHERE b.id = p.marca_id)) AS publications_without_brand;
+
+-- 14. Guard 0005 sem expor arrays, IDs, e-mails ou snapshot bruto.
+SELECT migration_key,
+       brands_count,
+       lists_count,
+       keywords_count,
+       keywords_without_list,
+       keywords_with_list,
+       cardinality(brand_ids) AS snapshot_brand_ids_count,
+       cardinality(list_ids) AS snapshot_list_ids_count,
+       cardinality(keyword_ids) AS snapshot_keyword_ids_count,
+       cardinality(membership_ids) AS snapshot_membership_ids_count,
+       cardinality(permission_keys) AS snapshot_permission_keys_count,
+       cardinality(table_grant_keys) AS snapshot_table_grants_count,
+       owner_column_existed,
+       keyword_brand_column_existed,
+       lists_marca_was_not_null,
+       applied_at,
+       md5(coalesce(lista_id_fingerprint, '')) AS lista_id_fingerprint_hash
+FROM public.tenant_0005_migration_guard
+ORDER BY applied_at, migration_key;
+
