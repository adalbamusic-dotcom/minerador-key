@@ -0,0 +1,51 @@
+export type GoogleAdsErrorCode =
+  | "google_ads_configuration"
+  | "google_ads_oauth"
+  | "google_ads_account_not_authorized"
+  | "google_ads_invalid_customer_id"
+  | "google_ads_developer_token"
+  | "google_ads_quota"
+  | "google_ads_rate_limited"
+  | "google_ads_timeout"
+  | "google_ads_invalid_request"
+  | "google_ads_invalid_response"
+  | "google_ads_provider_error";
+
+const messages: Record<GoogleAdsErrorCode, string> = {
+  google_ads_configuration: "A integra├º├úo Google Ads n├úo est├í configurada para esta opera├º├úo.",
+  google_ads_oauth: "N├úo foi poss├¡vel autorizar a integra├º├úo Google Ads.",
+  google_ads_account_not_authorized: "A conta anunciante n├úo est├í autorizada para esta opera├º├úo.",
+  google_ads_invalid_customer_id: "A conta anunciante informada ├® inv├ílida.",
+  google_ads_developer_token: "O acesso da integra├º├úo Google Ads foi recusado.",
+  google_ads_quota: "A quota da integra├º├úo Google Ads foi atingida.",
+  google_ads_rate_limited: "A integra├º├úo Google Ads limitou temporariamente esta opera├º├úo.",
+  google_ads_timeout: "A integra├º├úo Google Ads demorou mais do que o esperado.",
+  google_ads_invalid_request: "A solicita├º├úo para Google Ads ├® inv├ílida.",
+  google_ads_invalid_response: "Google Ads retornou uma resposta incompat├¡vel.",
+  google_ads_provider_error: "Google Ads n├úo concluiu a opera├º├úo.",
+};
+
+export class GoogleAdsError extends Error {
+  readonly code: GoogleAdsErrorCode;
+  readonly status: number;
+  readonly requestId: string | null;
+
+  constructor(code: GoogleAdsErrorCode, options: { status?: number; requestId?: string | null; cause?: unknown } = {}) {
+    super(messages[code], { cause: options.cause });
+    this.name = "GoogleAdsError";
+    this.code = code;
+    this.status = options.status ?? 500;
+    this.requestId = options.requestId ?? null;
+  }
+}
+
+export function toGoogleAdsError(error: unknown): GoogleAdsError {
+  if (error instanceof GoogleAdsError) return error;
+  if (error instanceof DOMException && error.name === "TimeoutError") return new GoogleAdsError("google_ads_timeout", { cause: error });
+  return new GoogleAdsError("google_ads_provider_error", { cause: error });
+}
+
+export function googleAdsSafeError(error: unknown) {
+  const normalized = toGoogleAdsError(error);
+  return { code: normalized.code, message: normalized.message, requestId: normalized.requestId };
+}
